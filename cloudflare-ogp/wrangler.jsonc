{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ogp",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-30",
  "rules": [
    { "type": "Data", "globs": ["**/*.jpg", "**/*.png"], "fallthrough": false },
  ],
  "observability": {
    "enabled": true,
  },
}
