{
  "name": "mermaid-compare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:ogp": "node scripts/generate-ogp.mjs",
    "prebuild": "node scripts/generate-ogp.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:worker": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:pages": "pnpm build && wrangler pages deploy dist --project-name=mermaid-compare",
    "test": "vitest run"
  },
  "dependencies": {
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wasm-html-to-image": "^1.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
